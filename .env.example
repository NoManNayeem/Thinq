# Copy to .env and adjust. Every value has a working default for local use.

# Port the web app is served on.
THINQ_PORT=3000

# Database credentials for the bundled PostgreSQL container.
POSTGRES_USER=thinq
POSTGRES_PASSWORD=thinq
POSTGRES_DB=thinq

# Folder containing users.csv. Loaded once, only into an empty database. See seed/README.md.
THINQ_SEED_PATH=./seed/sample
# Initial password for seeded users. Leave empty to allow demo sign-in only.
THINQ_SEED_PASSWORD=thinq-demo-2026

# One-click sign-in as any active user. For demos and local development only.
THINQ_DEMO_MODE=true

# Set to true when serving over HTTPS.
THINQ_COOKIE_SECURE=false

# ---- AI answers (optional) ------------------------------------------------------------
# Any Pydantic AI "provider:model". Leave empty for preview mode (excerpts, no AI model).
#   THINQ_LLM_MODEL=openai:gpt-5.2                 + OPENAI_API_KEY=...
#   THINQ_LLM_MODEL=anthropic:claude-sonnet-5-5    + ANTHROPIC_API_KEY=...
#   THINQ_LLM_MODEL=google-gla:gemini-3-flash      + GOOGLE_API_KEY=...
#   THINQ_LLM_MODEL=groq:llama-4-scout             + GROQ_API_KEY=...
#   THINQ_LLM_MODEL=ollama:qwen3:4b-instruct-2507-q4_K_M   (local Ollama, no key)
THINQ_LLM_MODEL=
# Tried in order if the main model fails, comma-separated.
THINQ_LLM_FALLBACK_MODELS=
# Where a local Ollama listens, as seen from the backend container.
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# ---- Cognee knowledge graph (optional) ------------------------------------------------
# Adds semantic search and extracted entities, stored in the same PostgreSQL server
# (database "cognee"). Thinq still checks every result against its own access rules.
# To enable: uncomment both lines, then `docker compose up -d --build --wait`.
# COMPOSE_PROFILES=cognee
# THINQ_RETRIEVER=cognee
COGNEE_PASSWORD=thinq-cognee
# The model Cognee uses to extract entities (default: local Ollama).
COGNEE_LLM_PROVIDER=ollama
COGNEE_LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
COGNEE_LLM_ENDPOINT=http://host.docker.internal:11434
COGNEE_LLM_API_KEY=ollama
